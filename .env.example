APP_NAME="Tada Tap"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/London
APP_URL=http://localhost

# Where owner-uploaded banner images are written. Defaults to public/uploads;
# set it to the web root's uploads folder if the host serves another folder.
# UPLOADS_ROOT=/home/user/public_html/uploads
# The URL those files are served from (relative, so it works on any domain).
# UPLOADS_URL=/uploads

# Loyalty rules (config/loyalty.php). Optional - these are the defaults.
# Hours a staff PIN sign-in lasts on a shared device.
# STAFF_SESSION_HOURS=12
# Minutes between stamps for shops with "Multiple stamps a day".
# MULTI_STAMP_GAP_MINUTES=2
# Free trial length for a new shop, in days.
# TRIAL_DAYS=30
# WhatsApp offers: at most one campaign per shop in this many hours.
# MARKETING_COOLDOWN_HOURS=24

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loyalty_hub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

STAMP_COOLDOWN_HOURS=8

# Bearer token for POST /deploy/migrate and POST /deploy/seed-admin (runs
# migrations / bootstraps the admin account over HTTP on hosts without SSH
# access). Leave blank locally/in dev - both routes refuse to run without one
# set. Generate for production with e.g.
#   php artisan tinker --execute="echo Str::random(64);"
DEPLOY_MIGRATE_TOKEN=

# Credentials for the one admin account POST /deploy/seed-admin creates.
# Leave blank locally - DatabaseSeeder creates a dev admin instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# "Continue with Google" for shop owners - an OAuth client from Google Cloud
# Console (APIs & Services > Credentials > OAuth client ID > Web application).
# Leave blank to hide the Google button. The redirect URI is relative by
# default; register the full {APP_URL}/auth/google/callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# UK address lookup on the shop address forms (findaddress.io). Server-side
# only - leave blank to hide "Find address".
FINDADDRESS_API_KEY=

# Landing page currency by the visitor's country (ipinfo.io Lite, free token).
# Server-side only - leave blank and everyone sees the default currency.
IPINFO_TOKEN=

# Product catalog API (our other application) - where menu item photos come
# from (App\Services\ProductCatalog). Requests are HMAC-signed: the public key
# identifies us, the private key signs each request and is never sent. Both
# come from the catalog app's API key settings. Server-side only - leave blank
# and menu items simply have no photos.
PRODUCT_API_URL=
PRODUCT_API_PUBLIC_KEY=
PRODUCT_API_PRIVATE_KEY=
# Only set to false for a local catalog with a self-signed certificate.
PRODUCT_API_VERIFY_SSL=true
# How sure Gemini must be (0-1) that a catalog photo matches the menu item.
MENU_IMAGE_MIN_CONFIDENCE=0.75

# Gemini reads photos/PDFs of a shop's menu (Admin → shop → Menu) and checks
# catalog photos. Server-side only (aistudio.google.com → API keys).
# Blank = type menus in by hand.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Your plan's per-model limits (Google AI Studio → Rate Limit) - shown as meters on Admin → AI usage
GEMINI_TIER="Tier 1"
GEMINI_LIMIT_RPM=1000
GEMINI_LIMIT_TPM=2000000
GEMINI_LIMIT_RPD=10000

# WhatsApp offers go out from each shop's OWN number, connected by the owner
# (Dashboard → WhatsApp: Meta's popup, or the keys from their own Meta app).
# These templates (body: App\Services\WhatsAppGateway::TEMPLATE_BODY) are
# created on each shop's account when it connects (App\Services\WhatsAppTemplates);
# Meta must approve them before offers can go.
WHATSAPP_TEMPLATE=shop_offer
# Same body + button with an Image header - used when the owner adds a poster.
WHATSAPP_TEMPLATE_IMAGE=shop_offer_image
WHATSAPP_TEMPLATE_LANGUAGE=en_GB
# Meta Graph API version used for every WhatsApp call. Optional (default v21.0).
# WHATSAPP_API_VERSION=v21.0

# Our Meta app (developers.facebook.com), for owners connecting their own
# number with Meta's popup (Embedded Signup). App settings → Basic gives the
# app id + secret; Facebook Login for Business → Configurations gives the
# configuration id. The secret stays server-side. Blank = no popup; owners
# connect with their own keys instead.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Webhook (delivery / read ticks, customers' replies, template approvals):
# Meta → WhatsApp → Configuration → callback {APP_URL}/api/whatsapp/webhook,
# this token as "Verify token", fields: messages, message_template_status_update.
# Any long random string. Signed with META_APP_SECRET.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Stripe Checkout for product orders (Developers → API keys / Webhooks).
# Leave blank to hide online ordering. Use sk_test_ keys locally.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_...) for the plan payment card form. Webhook URL
# {APP_URL}/api/stripe/webhook, events: checkout.session.completed,
# checkout.session.async_payment_succeeded, payment_intent.succeeded,
# charge.refunded, charge.dispute.created.
STRIPE_KEY=

# Razorpay - plan payments for every country not set to Stripe (Admin → Landing
# page → Billing → Payments). Webhook URL {APP_URL}/api/razorpay/webhook, events
# payment.authorized, payment.captured, order.paid, refund.processed,
# payment.dispute.created. Leave blank and plans can't be paid online.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
